# NXT Level Builds — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Email (Resend) ───
# Required for contact form, audit requests, and chat lead capture
RESEND_API_KEY=re_xxxxxxxxxxxx

# ─── Analytics (Google Analytics 4) ───
# Required for page views and event tracking
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# ─── Analytics (Meta Pixel) ───
# Required for Meta conversion tracking
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXX

# ─── Site URL (Production) ───
# Used for canonical URLs, sitemap, and OG images
# NEXT_PUBLIC_SITE_URL=https://nxtlevelbuilds.com

# ─── Calendly ───
# Used for booking consultation links
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/nxtlevelbuilds/consultation
